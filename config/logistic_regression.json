{
  "feature_table": "outputs/candidate_feature_table.csv",
  "labels_table": "outputs/candidate_labels.csv",
  "cv_folds": "outputs/cross_validation_folds.csv",
  "output_dir": "outputs/logistic_regression",
  "model_features": [
    "gps_to_segment_distance_meters",
    "gps_to_segment_start_meters",
    "gps_to_segment_end_meters",
    "segment_length_meters",
    "candidate_rank",
    "candidate_count",
    "gps_speed_mps",
    "gps_movement_direction_degrees",
    "previous_gps_speed_mps",
    "previous_movement_direction_degrees",
    "previous_delta_time_seconds",
    "road_segment_direction_degrees",
    "gps_road_direction_difference_degrees",
    "delta_time_seconds",
    "speed_suspicious"
  ],
  "target": "label",
  "drop_unlabeled": true,
  "train_partition": "train",
  "student_test_partition": "student_test",
  "n_cv_folds": 5,
  "random_state": 42,
  "tuning": {
    "n_calls": 40,
    "param_space": {
      "C":            [1e-4, 1e2],
      "max_iter":     [200, 2000],
      "penalty":      ["l1", "l2", "elasticnet"],
      "solver":       ["saga"],
      "class_weight": ["balanced", null],
      "l1_ratio":     [0.0, 1.0]
    }
  },
  "final_fit": {
    "max_iter": 2000
  }
}
