# Full GPS feature table (33 MB, regenerable via dataset_preprocessing.py)
outputs/gps_feature_table.csv

# Candidate table: currently incomplete (13/90 trips only). Exclude to avoid
# misleading teammates. Regenerate with candidate_generation.py after fixing
# the --dataset-root argument.
outputs/candidate_table.csv

# Downstream outputs that do not exist yet (excluded so Git does not
# accidentally pick them up if partially generated in the future)
outputs/candidate_feature_table.csv
outputs/candidate_labels.csv
outputs/candidate_generation_summary.csv
outputs/route_alignment_summary.csv
outputs/dataset_validation_summary.csv
outputs/candidate_feature_missing_values.csv
outputs/dataset_validation_report.md

